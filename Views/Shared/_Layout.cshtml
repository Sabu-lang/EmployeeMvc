<!DOCTYPE html>
<html lang="ka">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - თანამშრომლების მართვა</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark app-navbar mb-4">
            <div class="container">
                <a class="navbar-brand fw-semibold" asp-controller="Employees" asp-action="Index">
                    <i class="bi bi-people-fill me-2"></i>თანამშრომლების მართვა
                </a>
                <div class="navbar-nav ms-auto align-items-sm-center gap-2">
                    @if (User?.Identity != null && User.Identity.IsAuthenticated)
                    {
                        var canManageEmployees = User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.Manager);
                        var isStaff = canManageEmployees || User.IsInRole(AppRoles.Support);

                        <a class="nav-link" asp-controller="Employees" asp-action="Index">
                            <i class="bi bi-list-ul me-1"></i>@(isStaff ? "სია" : "ჩემი პროფილი")
                        </a>
                        @if (canManageEmployees)
                        {
                            <a class="nav-link" asp-controller="Employees" asp-action="Create">
                                <i class="bi bi-plus-circle me-1"></i>დამატება
                            </a>
                        }
                        <a class="nav-link" asp-controller="Tasks" asp-action="Index">
                            <i class="bi bi-kanban me-1"></i>Task Board
                        </a>
                        <a class="nav-link" asp-controller="Groups" asp-action="Index">
                            <i class="bi bi-diagram-3 me-1"></i>ჯგუფები
                        </a>
                        @if (User.IsInRole(AppRoles.Admin))
                        {
                            <a class="nav-link" asp-controller="Users" asp-action="Index">
                                <i class="bi bi-person-gear me-1"></i>მომხმარებლები
                            </a>
                        }

                        <a class="nav-link text-white-50" asp-controller="Account" asp-action="Security" title="უსაფრთხოება (2FA)">
                            <i class="bi bi-person-circle me-1"></i>@User.Identity.Name
                        </a>
                        <form class="d-inline" asp-controller="Account" asp-action="Logout" method="post">
                            <button type="submit" class="btn btn-sm btn-outline-light">
                                <i class="bi bi-box-arrow-right me-1"></i>გასვლა
                            </button>
                        </form>
                    }
                    else
                    {
                        <a class="btn btn-sm btn-outline-light" asp-controller="Account" asp-action="Login">
                            <i class="bi bi-box-arrow-in-right me-1"></i>შესვლა
                        </a>
                        <a class="btn btn-sm btn-light" asp-controller="Account" asp-action="Register">
                            <i class="bi bi-person-plus me-1"></i>რეგისტრაცია
                        </a>
                    }
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted text-center py-3 mt-4">
        <div class="container">
            &copy; @DateTime.Now.Year - Employee Management System
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
