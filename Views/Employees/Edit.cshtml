@model Employee

@{
    ViewData["Title"] = "თანამშრომლის რედაქტირება";
}

@{

    var selfEdit = ViewData["SelfEdit"] is true;
}

<h1>@(selfEdit ? "ჩემი პროფილის რედაქტირება" : "თანამშრომლის რედაქტირება")</h1>

<div class="form-panel">
    @if (!string.IsNullOrEmpty(Model.PhotoPath))
    {
        <img src="@Model.PhotoPath" alt="@Model.FullName" class="current-photo-preview" />
    }

    <form asp-action="Edit" method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="PhotoPath" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="PhotoFile" class="form-label">ახალი ფოტოს ატვირთვა (სურვილისამებრ)</label>
            <input asp-for="PhotoFile" class="form-control" accept=".jpg,.jpeg,.png,.webp" />
            <span asp-validation-for="PhotoFile" class="text-danger"></span>
            <div class="form-text">თუ ატვირთავ ახალს, ძველი ფოტო ჩანაცვლდება.</div>
        </div>

        <div class="mb-3">
            <label asp-for="FullName" class="form-label"></label>
            <input asp-for="FullName" class="form-control" />
            <span asp-validation-for="FullName" class="text-danger"></span>
        </div>

        @if (!selfEdit)
        {
            <div class="mb-3">
                <label asp-for="Position" class="form-label"></label>
                <input asp-for="Position" class="form-control" />
                <span asp-validation-for="Position" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Department" class="form-label"></label>
                <input asp-for="Department" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="HireDate" class="form-label"></label>
                <input asp-for="HireDate" class="form-control" type="date" />
            </div>

            <div class="mb-3 form-check">
                <input asp-for="IsWorking" class="form-check-input" />
                <label asp-for="IsWorking" class="form-check-label"></label>
            </div>
        }

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-check-circle me-1"></i>შენახვა
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary">გაუქმება</a>
        </div>
    </form>
</div>
