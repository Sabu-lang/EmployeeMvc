@model IEnumerable<UserListItemViewModel>

@{
    ViewData["Title"] = "მომხმარებლები";
    var searchEmail = ViewData["SearchEmail"] as string ?? string.Empty;

    string BadgeClass(string role) => role switch
    {
        AppRoles.Admin => "role-badge role-admin",
        AppRoles.Manager => "role-badge role-manager",
        AppRoles.Support => "role-badge role-support",
        _ => "role-badge"
    };
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <h1 class="mb-0">მომხმარებლები და როლები</h1>
</div>

<form asp-action="Index" method="get" class="data-panel mb-3">
    <label for="email-search" class="form-label">დარეგისტრირებული მომხმარებლის ელფოსტით ძებნა</label>
    <div class="input-group">
        <input id="email-search" name="email" type="search" value="@searchEmail"
               class="form-control" placeholder="შეიყვანე ელფოსტა ან მისი ნაწილი" autocomplete="off" />
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-search me-1"></i>ძებნა
        </button>
        @if (!string.IsNullOrWhiteSpace(searchEmail))
        {
            <a asp-action="Index" class="btn btn-outline-secondary">გასუფთავება</a>
        }
    </div>
    <div class="form-text">ძებნაში ჩანს შენი ჯგუფების თანამშრომლები და ჯერ ჯგუფში არმყოფი რეგისტრირებული მომხმარებლები.</div>
</form>

@if (TempData["UserSuccess"] != null)
{
    <div class="alert alert-success">@TempData["UserSuccess"]</div>
}
@if (TempData["UserError"] != null)
{
    <div class="alert alert-danger">@TempData["UserError"]</div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">
        @if (!string.IsNullOrWhiteSpace(searchEmail))
        {
            <span>ამ ელფოსტით შესაბამისი რეგისტრირებული მომხმარებელი ვერ მოიძებნა.</span>
        }
        else
        {
            <span>ჯგუფებში ჯერ თანამშრომლები არ არიან. მოძებნე უკვე დარეგისტრირებული მომხმარებელი ზემოთ.</span>
        }
    </div>
}

<div class="data-panel table-responsive">
    <table class="table align-middle mb-0">
        <thead>
            <tr>
                <th>ელფოსტა</th>
                <th>როლები</th>
                <th>სტატუსი</th>
                <th class="text-end">მოქმედებები</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>
                        @user.Email
                        @if (user.IsCurrentUser)
                        {
                            <span class="text-muted small">(თქვენ)</span>
                        }
                    </td>
                    <td>
                        @foreach (var role in user.Roles)
                        {
                            <span class="@BadgeClass(role)">@role</span>
                        }
                    </td>
                    <td>
                        @if (!user.EmailConfirmed)
                        {
                            <span class="badge-status badge-inactive">არადადასტურებული</span>
                        }
                        @if (user.TwoFactorEnabled)
                        {
                            <span class="badge-status badge-working">2FA</span>
                        }
                        @if (user.IsLockedOut)
                        {
                            <span class="badge-status bg-danger-subtle text-danger">დაბლოკილი</span>
                        }
                    </td>
                    <td class="text-end">
                        @if (user.CanManageRoles)
                        {
                            <a asp-action="Roles" asp-route-id="@user.Id" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-shield-check me-1"></i>როლის შეცვლა
                            </a>
                        }
                        @if (user.IsCurrentUser)
                        {
                            <a asp-action="Roles" asp-route-id="@user.Id" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-shield-check me-1"></i>როლები
                            </a>
                        }
                        @if (user.CanDelete)
                        {
                            <form asp-action="Delete" asp-route-id="@user.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('წავშალო ეს მომხმარებელი?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="წაშლა">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
