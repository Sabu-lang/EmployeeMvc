@model UserRolesViewModel

@{
    ViewData["Title"] = "როლების მართვა";

    var descriptions = new Dictionary<string, string>
    {
        [AppRoles.Admin] = "სრული წვდომა: მომხმარებლები, როლები, ჯგუფები, ყველა თანამშრომელი",
        [AppRoles.Manager] = "თანამშრომლების მართვა, ჯგუფების შექმნა და საკუთარი ჯგუფების მართვა",
        [AppRoles.Support] = "თანამშრომლების ინფორმაციის ნახვა (მხოლოდ წაკითხვა)",
        [AppRoles.Employee] = "ჩვეულებრივი მომხმარებელი: საკუთარი პროფილი, საკუთარი დავალებები, საკუთარი ჯგუფები"
    };
}

<h1>როლების მართვა</h1>

<div class="form-panel">
    @if (TempData["UserError"] != null)
    {
        <div class="alert alert-danger">@TempData["UserError"]</div>
    }

    <p class="text-muted">მომხმარებელი: <strong>@Model.Email</strong></p>

    <form asp-action="Roles" method="post">
        <input type="hidden" name="id" value="@Model.UserId" />

        @foreach (var role in Model.AllRoles)
        {
            <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" name="selectedRoles" value="@role"
                       id="role-@role" @(Model.SelectedRoles.Contains(role) ? "checked" : null) />
                <label class="form-check-label" for="role-@role">
                    <strong>@role</strong>
                    <div class="small text-muted">@(descriptions.TryGetValue(role, out var d) ? d : "")</div>
                </label>
            </div>
        }

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-check-circle me-1"></i>შენახვა
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary">გაუქმება</a>
        </div>
    </form>
</div>
