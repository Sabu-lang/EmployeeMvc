@model string[]

@{
    ViewData["Title"] = "Recovery კოდები";
}

<h1>Recovery კოდები</h1>

<div class="form-panel">
    <div class="alert alert-warning">
        <strong>შეინახე ეს კოდები უსაფრთხო ადგილას.</strong>
        ისინი მხოლოდ ახლა ჩანს და მეორედ ვეღარ ნახავ. თუ ტელეფონზე წვდომას დაკარგავ,
        თითოეული კოდით ერთხელ შეძლებ ანგარიშში შესვლას.
    </div>

    <div class="recovery-codes">
        @foreach (var code in Model)
        {
            <code>@code</code>
        }
    </div>

    <a asp-action="Security" class="btn btn-primary mt-3">
        <i class="bi bi-check2 me-1"></i>შევინახე, გაგრძელება
    </a>
</div>
