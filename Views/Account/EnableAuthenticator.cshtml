@model EnableAuthenticatorViewModel

@{
    ViewData["Title"] = "Authenticator-ის გააქტიურება";
}

<h1>Authenticator-ის გააქტიურება</h1>

<div class="form-panel">
    @if (TempData["SecurityMessage"] != null)
    {
        <div class="alert alert-info">@TempData["SecurityMessage"]</div>
    }

    <ol class="ps-3">
        <li class="mb-3">
            ჩამოტვირთე Authenticator აპლიკაცია: <strong>Google Authenticator</strong>,
            <strong>Microsoft Authenticator</strong> ან <strong>Authy</strong>.
        </li>
        <li class="mb-3">
            დაასკანირე QR კოდი აპლიკაციით, ან ხელით შეიყვანე გასაღები:
            <div class="qr-box">
                @if (!string.IsNullOrEmpty(Model.QrCodeDataUri))
                {
                    <img src="@Model.QrCodeDataUri" alt="QR კოდი" width="200" height="200" />
                }
            </div>
            <div class="text-center">
                <code class="shared-key">@Model.SharedKey</code>
            </div>
        </li>
        <li>
            აპლიკაციაში გამოჩნდება 6-ნიშნა კოდი — შეიყვანე ქვემოთ დასადასტურებლად.
        </li>
    </ol>

    <form asp-action="EnableAuthenticator" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="Code" class="form-label"></label>
            <input asp-for="Code" class="form-control otp-input" maxlength="7" inputmode="numeric"
                   autocomplete="one-time-code" placeholder="000000" />
            <span asp-validation-for="Code" class="text-danger"></span>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-check-circle me-1"></i>დადასტურება და ჩართვა
            </button>
            <a asp-action="Security" class="btn btn-outline-secondary">გაუქმება</a>
        </div>
    </form>
</div>
