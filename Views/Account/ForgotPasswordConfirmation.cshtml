@{
    ViewData["Title"] = "წერილი გაგზავნილია";
}

<div class="auth-wrapper">
    <div class="auth-panel">
        <div class="auth-icon">
            <i class="bi bi-envelope-check-fill"></i>
        </div>
        <h1 class="auth-title">შეამოწმე ელფოსტა</h1>
        <p class="auth-subtitle">
            თუ ასეთი ელფოსტით ანგარიში არსებობს, პაროლის აღდგენის ბმული გაიგზავნა.
            ბმული მოქმედია 1 საათის განმავლობაში.
        </p>
        <a asp-controller="Account" asp-action="Login" class="btn btn-primary w-100">შესვლის გვერდზე</a>
    </div>
</div>
