@model VerifyEmailViewModel

@{
    ViewData["Title"] = "ელფოსტის დადასტურება";
    Layout = "_Layout";
}

<div class="auth-wrapper">
    <div class="auth-panel">
        <div class="auth-icon">
            <i class="bi bi-envelope-check-fill"></i>
        </div>
        <h1 class="auth-title">დაადასტურე ელფოსტა</h1>
        <p class="auth-subtitle">
            6-ნიშნა კოდი გაიგზავნა მისამართზე <strong>@Model.Email</strong>
        </p>

        @if (TempData["InfoMessage"] != null)
        {
            <div class="alert alert-info">@TempData["InfoMessage"]</div>
        }

        <form asp-controller="Account" asp-action="VerifyEmail" method="post">
            <input type="hidden" asp-for="Email" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Code" class="form-label"></label>
                <input asp-for="Code" class="form-control otp-input" maxlength="6"
                       inputmode="numeric" autocomplete="one-time-code" placeholder="000000" />
                <span asp-validation-for="Code" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100 mb-3">
                <i class="bi bi-check-circle me-1"></i>დადასტურება
            </button>
        </form>

        <form asp-controller="Account" asp-action="ResendCode" method="post">
            <input type="hidden" name="email" value="@Model.Email" />
            <button type="submit" class="btn btn-link w-100">კოდი არ მოვიდა? გაგზავნა თავიდან</button>
        </form>
    </div>
</div>
