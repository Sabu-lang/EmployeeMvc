@model GroupFormViewModel

<form asp-action="@(Model.Id == null ? "Create" : "Edit")" asp-route-id="@Model.Id" method="post">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" maxlength="100" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="3" maxlength="500"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    @if (Model.CanChooseOwner)
    {
        <div class="mb-3">
            <label asp-for="OwnerId" class="form-label"></label>
            <select asp-for="OwnerId" asp-items="Model.OwnerOptions" class="form-select">
                <option value="">— აირჩიე მფლობელი —</option>
            </select>
            <span asp-validation-for="OwnerId" class="text-danger"></span>
            <div class="form-text">მფლობელი შეიძლება იყოს მხოლოდ Manager ან Admin როლის მომხმარებელი.</div>
        </div>
    }
    else
    {
        <div class="form-text mb-3">ჯგუფის მფლობელი ხართ თქვენ. მფლობელის შეცვლა მხოლოდ Admin-ს შეუძლია.</div>
    }

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-check-circle me-1"></i>შენახვა
        </button>
        <a asp-action="Index" class="btn btn-outline-secondary">გაუქმება</a>
    </div>
</form>
